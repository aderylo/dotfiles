#!/bin/bash
# shellcheck shell=bash

# Catppuccin Mocha colors used by the task UI.
NC='\033[0m'
CAT_RED='\033[38;2;243;139;168m'
CAT_MAROON='\033[38;2;235;160;172m'
CAT_GREEN='\033[38;2;166;227;161m'
CAT_TEAL='\033[38;2;148;226;213m'
CAT_SAPPHIRE='\033[38;2;116;199;236m'
CAT_BLUE='\033[38;2;137;180;250m'
CAT_TEXT='\033[38;2;205;214;244m'
CAT_OVERLAY1='\033[38;2;127;132;156m'

CHECK_MARK="${CAT_GREEN}\xE2\x9C\x94${NC}"
ARROW="${CAT_SAPPHIRE}\xE2\x96\xB6${NC}"

set -e

if ! command -v tput >/dev/null 2>&1; then
  printf "${CAT_RED}Error: 'tput' is required but not found.${NC}\n" >&2
  exit 1
fi

# Paths and task state
DOTFILES_LOG="$HOME/.dotfiles.log"
DOTFILES_DIR="$HOME/.dotfiles"
IS_FIRST_RUN="$HOME/.dotfiles_run"
TASK=""
SPINNER_PID=""

cleanup() {
  if [[ $SPINNER_PID != "" ]]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
  fi
  tput cnorm 2>/dev/null || true
  printf "${NC}"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

_spinner() {
  local task_text=$1
  local chars=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  local char

  tput civis 2>/dev/null || true
  while true; do
    for char in "${chars[@]}"; do
      printf "\r\033[K${CAT_OVERLAY1} [${CAT_SAPPHIRE}%s${CAT_OVERLAY1}]  ${CAT_TEXT}%s${NC}" "$char" "$task_text" >&2
      sleep 0.08
    done
  done
}

__task() {
  if [[ $TASK != "" ]] && [[ $SPINNER_PID != "" ]]; then
    _task_done
  fi

  TASK=$1
  _spinner "$TASK" &
  SPINNER_PID=$!
  disown "$SPINNER_PID" 2>/dev/null || true
}

_clear_task() {
  TASK=""
}

_task_done() {
  if [[ $SPINNER_PID != "" ]]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
    SPINNER_PID=""
  fi

  tput cnorm 2>/dev/null || true
  printf "\r\033[K${CAT_GREEN} [✓]  ${CAT_TEXT}%s${NC}\n" "$TASK"
  _clear_task
}

_cmd() {
  : > "$DOTFILES_LOG"

  if eval "$1" > /dev/null 2> "$DOTFILES_LOG"; then
    return 0
  fi

  if [[ $SPINNER_PID != "" ]]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
    SPINNER_PID=""
  fi

  tput cnorm 2>/dev/null || true
  printf "\r\033[K${CAT_RED} [✗]  ${CAT_TEXT}%s${NC}\n" "$TASK"

  local line
  while IFS= read -r line; do
    printf "      ${CAT_MAROON}%s${NC}\n" "$line"
  done < "$DOTFILES_LOG"
  printf "\n"
  rm -f "$DOTFILES_LOG"
  exit 1
}

function ubuntu_setup() {
  if ! dpkg -s ansible >/dev/null 2>&1; then
    __task "Installing Ansible"
    _cmd "sudo apt-get update"
    _cmd "sudo apt-get install -y software-properties-common"
    _cmd "sudo apt-add-repository -y ppa:ansible/ansible"
    _cmd "sudo apt-get update"
    _cmd "sudo apt-get install -y ansible"
    _cmd "sudo apt-get install python3-argcomplete"
    _cmd "sudo activate-global-python-argcomplete3"
  fi
  if ! dpkg -s python3 >/dev/null 2>&1; then
    __task "Installing Python3"
    _cmd "sudo apt-get install -y python3"
  fi

}


function macos_setup() {
  if ! [ -x "$(command -v brew)" ]; then
    __task "Installing Homebrew"
    _cmd "/bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
  fi
  if ! [ -x "$(command -v git)" ]; then
    __task "Installing Git"
    _cmd "brew install git"
  fi
  if ! [ -x "$(command -v ansible)" ]; then
    __task "Installing Ansible"
    _cmd "brew install ansible"
  fi
}

update_ansible_galaxy() {
  local os=$1
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
  local cache_file="$cache_dir/ansible-galaxy.checksum"
  local requirements_files=("$DOTFILES_DIR/requirements/common.yml")

  if [ -f "$DOTFILES_DIR/requirements/$os.yml" ]; then
    requirements_files+=("$DOTFILES_DIR/requirements/$os.yml")
  fi

  local requirements_checksum
  requirements_checksum=$(cksum "${requirements_files[@]}" | cksum | awk '{print $1 ":" $2}')

  if [ -f "$cache_file" ] && [ "$(< "$cache_file")" = "$requirements_checksum" ]; then
    __task "Ansible Galaxy requirements unchanged"
    _task_done
    return
  fi

  local requirements_file
  for requirements_file in "${requirements_files[@]}"; do
    __task "Installing Ansible dependencies from ${requirements_file#$DOTFILES_DIR/}"
    _cmd "ansible-galaxy collection install -r '$requirements_file'"
    _task_done
  done

  mkdir -p "$cache_dir"
  printf '%s\n' "$requirements_checksum" > "$cache_file"
}

detect_os() {
  if [ -f /etc/os-release ]; then
    source /etc/os-release
    echo $ID
  else
    echo $(uname -s | tr '[:upper:]' '[:lower:]')
  fi
}

function print_banner() {
  echo ""
  echo -e "${CAT_SAPPHIRE}   █████╗ ██████╗ ███████╗██████╗ ██╗   ██╗██╗      ██████╗ ${NC}"
  echo -e "${CAT_SAPPHIRE}  ██╔══██╗██╔══██╗██╔════╝██╔══██╗╚██╗ ██╔╝██║     ██╔═══██╗${NC}"
  echo -e "${CAT_SAPPHIRE}  ███████║██║  ██║█████╗  ██████╔╝ ╚████╔╝ ██║     ██║   ██║${NC}"
  echo -e "${CAT_SAPPHIRE}  ██╔══██║██║  ██║██╔══╝  ██╔══██╗  ╚██╔╝  ██║     ██║   ██║${NC}"
  echo -e "${CAT_SAPPHIRE}  ██║  ██║██████╔╝███████╗██║  ██║   ██║   ███████╗╚██████╔╝${NC}"
  echo -e "${CAT_SAPPHIRE}  ╚═╝  ╚═╝╚═════╝ ╚══════╝╚═╝  ╚═╝   ╚═╝   ╚══════╝ ╚═════╝ ${NC}"
  echo ""
  echo -e "${CAT_BLUE}      ██████╗  ██████╗ ████████╗███████╗██╗██╗     ███████╗███████╗${NC}"
  echo -e "${CAT_BLUE}      ██╔══██╗██╔═══██╗╚══██╔══╝██╔════╝██║██║     ██╔════╝██╔════╝${NC}"
  echo -e "${CAT_BLUE}      ██║  ██║██║   ██║   ██║   █████╗  ██║██║     █████╗  ███████╗${NC}"
  echo -e "${CAT_BLUE}      ██║  ██║██║   ██║   ██║   ██╔══╝  ██║██║     ██╔══╝  ╚════██║${NC}"
  echo -e "${CAT_BLUE}      ██████╔╝╚██████╔╝   ██║   ██║     ██║███████╗███████╗███████║${NC}"
  echo -e "${CAT_BLUE}      ╚═════╝  ╚═════╝    ╚═╝   ╚═╝     ╚═╝╚══════╝╚══════╝╚══════╝${NC}"
  echo ""
}

print_banner

dotfiles_os=$(detect_os)
__task "Loading Setup for detected OS: $dotfiles_os"
case $dotfiles_os in
  ubuntu)
    ubuntu_setup
    ;;
  darwin)
    macos_setup
    ;;
  *)
    __task "Unsupported OS"
    _cmd "echo 'Unsupported OS'"
    ;;
esac


if ! [[ -d "$DOTFILES_DIR" ]]; then
  __task "Cloning repository"
  _cmd "git clone --quiet https://github.com/aderylo/dotfiles.git $DOTFILES_DIR"
else
  __task "Updating repository"
  _cmd "git -C $DOTFILES_DIR pull --quiet"
fi
_task_done

pushd "$DOTFILES_DIR" 2>&1 > /dev/null
update_ansible_galaxy "$dotfiles_os"

ansible-playbook "$DOTFILES_DIR/main.yml" "$@"

popd 2>&1 > /dev/null

if ! [[ -f "$IS_FIRST_RUN" ]]; then
  echo -e "${CHECK_MARK} ${CAT_GREEN}First run complete!${NC}"
  echo -e "${ARROW} ${CAT_TEAL}Please reboot your computer to complete the setup.${NC}"
  touch "$IS_FIRST_RUN"
fi

# vi:ft=sh:
